    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Current Level",
            "type": "shell",
            "command": "make -C ${relativeFileDirname}",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            }
        }
    ]
}
