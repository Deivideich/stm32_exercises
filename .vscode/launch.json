            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "openocd",
            "gdbPath": "/usr/bin/gdb-multiarch",
            "preLaunchTask": "Build Current Level",
            "configFiles": [
                "${workspaceFolder}/stm32_levels/shared/g431kb/openocd.cfg"
            ],
            "toolchainPrefix": "arm-none-eabi",
            "armToolchainPath": "/usr/bin"
        }
    ]
